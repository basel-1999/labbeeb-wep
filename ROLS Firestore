rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 🛠️ دوال مساعدة للأمان ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.admin == true) ||
        (request.auth.token.role == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // مسؤول مالي: بيشوف طلبات الشحن فقط (حساب بإيميل وباسوورد بيعمله صاحب المنصة)
    function isFinance() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'finance';
    }

    // مين بيقدر يفتح طلبات الشحن: مسؤول مالي، أو أدمن أعطاه صاحب المنصة صلاحية canRecharge
    function canRecharge() {
      let uPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && exists(uPath) && (
        get(uPath).data.role == 'finance' ||
        (get(uPath).data.role == 'admin' && get(uPath).data.get('canRecharge', false) == true)
      );
    }

    // معلم معتمد فقط (هو الوحيد اللي بيشوف الطلبات المعلقة)
    function isApprovedTeacher() {
      let uPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && exists(uPath) &&
        get(uPath).data.role == 'teacher' &&
        get(uPath).data.status == 'approved';
    }

    function isSessionParticipant(sessionId) {
      let sessionPath = /databases/$(database)/documents/sessions/$(sessionId);
      return isAuthenticated() && (
        isAdmin() ||
        (exists(sessionPath) && (
          get(sessionPath).data.studentId == request.auth.uid ||
          get(sessionPath).data.teacherId == request.auth.uid
        ))
      );
    }

    function isSessionTeacher(sessionId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.teacherId == request.auth.uid;
    }

    function isDrawingAllowedForStudent(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('drawingAllowedForStudent', false) == true;
    }

    // --- 1. مجموعة المستخدمين ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // الأدمن ما بيقدر ينشئ حساب أدمن أو يعطي صلاحية canRecharge (هاد من Firebase Console بس)
      allow create: if (isAdmin() &&
        request.resource.data.get('role', '') != 'admin' &&
        !('canRecharge' in request.resource.data)) || (
        isOwner(userId) &&
        request.resource.data.role in ['student', 'teacher'] &&
        request.resource.data.get('points', 0) == 0 &&
        request.resource.data.get('totalStars', 0) == 0 &&
        (
          (request.resource.data.role == 'student' && request.resource.data.get('status', 'active') == 'active') ||
          (request.resource.data.role == 'teacher' && request.resource.data.get('status', 'pending_approval') == 'pending_approval')
        )
      );

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId);
        allow create, delete: if false;
      }

      // الأدمن ما بيقدر يغيّر role أو canRecharge (حتى ما حدا يعطي نفسه صلاحية الشحن)
      allow update: if (isAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'canRecharge'])) || (
        isOwner(userId) &&
        // 1. حقول ما حدا بيعدلها من المتصفح (السيرفر ولوحة الأدمن فقط)
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'points', 'role', 'status', 'isApproved', 'accountStatus', 'isAvailable',
          'hasUsedFreeTrial', 'pendingProfileUpdates', 'profileUpdateRequestedAt',
          'totalStars',
          'interviewVideoUrl', 'interviewCompletedAt', 'interviewSessionId',
          'canRecharge'
        ]) &&
        // لغة الطالب بتتحدد مرة وحدة (عند التسجيل)، وبعدها ما بتتغير من المتصفح لأنها بتحدد سعر الباقات
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['preferredLanguage']) ||
          resource.data.get('preferredLanguage', '') == ''
        ) &&
        // 2. المعلم (تجريبي، أو تمت مقابلته، أو معتمد) ما بيعدل بياناته الأكاديمية إلا عبر الإدارة
        (
          !(resource.data.get('status', '') in ['approved', 'trial', 'interviewed']) ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'name', 'country', 'city',
            'subject', 'subjects', 'targetAge', 'teachingLanguage', 'experienceYears',
            'ownedDevices', 'academicDegree',
            'certificates', 'certificateUrl', 'certificateName',
            'advancedDegreeCertificateUrl', 'identityUrl', 'identityFileName',
            'experienceCertificateUrl', 'experienceCertificateName'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // --- 2. الحصص والجلسات ---
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        (resource.data.status == 'pending' && isApprovedTeacher())
      );

      // الإنشاء يتم فقط عبر الباك-إند (Admin SDK) بعد فحص الرصيد
      allow create: if isAdmin();

      allow update: if isAdmin() || (
        isSessionParticipant(sessionId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'studentId', 'teacherId', 'assignedTeacherId',
          'status', 'completedAt', 'endReason',
          'timerStartedAt', 'pointsDeducted', 'lastDeductionAt',
          'studentJoinedAt', 'teacherJoinedAt',
          'starsAwarded', 'lastStarAt', 'isTrialInterview'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['drawingAllowedForStudent', 'screenShareAllowedForStudent', 'viewMode']) ||
          resource.data.teacherId == request.auth.uid
        )
      );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, write: if isSessionParticipant(sessionId);
      }

      match /strokes/{strokeId} {
        allow read: if isSessionParticipant(sessionId);

        allow create: if isSessionParticipant(sessionId) && (
          isSessionTeacher(sessionId) ||
          (isDrawingAllowedForStudent(sessionId) && request.resource.data.author == request.auth.uid)
        );

        allow update, delete: if isSessionParticipant(sessionId) && (
          isSessionTeacher(sessionId) ||
          (isDrawingAllowedForStudent(sessionId) && resource.data.get('author', '') == request.auth.uid)
        );
      }

      match /animations/{animationId} {
        allow read: if isSessionParticipant(sessionId);
        allow write: if isSessionTeacher(sessionId);
      }

      // ⭐ أحداث المكافآت: القراءة للطرفين، والكتابة للسيرفر فقط (Admin SDK)
      match /rewards/{rewardId} {
        allow read: if isSessionParticipant(sessionId);
        allow write: if false;
      }
      // 👆 المؤشر المباشر: كل طرف يكتب وثيقته هو فقط (الطالب بس لما المعلم يسمحله بالرسم)
      match /live/{docId} {
        allow read: if isSessionParticipant(sessionId);
        allow create, update: if isSessionParticipant(sessionId) &&
          docId == request.auth.uid &&
          request.resource.data.by == request.auth.uid &&
          (
            isSessionTeacher(sessionId) ||
            isDrawingAllowedForStudent(sessionId)
          );
      }
    }

    // --- 3. طلبات الشحن ---
    match /recharge_requests/{requestId} {
      allow read: if canRecharge();
      allow create: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // --- سجل استرجاع كلمات المرور (قراءة للأدمن فقط، والكتابة من السيرفر) ---
    match /password_resets/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- 4. محادثات الدعم الفني ---
    match /support_chats/{studentId} {
      allow read: if isAdmin() || isOwner(studentId);
      allow create: if isOwner(studentId);
      allow update: if isOwner(studentId) || isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || isOwner(studentId);
        allow create: if isAdmin() || (isOwner(studentId) && request.resource.data.sender == 'student');
      }
    }

  }
}